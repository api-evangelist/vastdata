    {
      "id": "6b961173-543f-4d18-8d05-bccb7ea5b20b",
      "name": "dns",
      "description": {
        "content": "The DNS path represents a VAST Cluster DNS service. You can create one VAST Cluster DNS service per cluster. The VAST Cluster DNS service can distribute incoming DNS requests to specific VIP pools, according to subdomains. The service is updated of changes to VIP pool ranges. It works with a single DNS delegation record on an external DNS server.",
        "type": "text/plain"
      },
