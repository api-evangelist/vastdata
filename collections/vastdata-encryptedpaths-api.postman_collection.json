    {
      "id": "7f11ec0e-283d-4ca8-aec5-26275bd1415a",
      "name": "encryptedpaths",
      "description": {
        "content": "An encrypted path is a path that is encrypted with a dedicated encryption group which is a subgroup of the encryption group of the tenant on which the path resides. Encrypted paths can be created on a cluster that has EKM (external key manager) encryption enabled. It is not possible to encrypt an existing path with its own encryption group.",
        "type": "text/plain"
      },
