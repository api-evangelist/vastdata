    {
      "id": "718c9787-d9f5-44d3-a132-2bb36fcf0962",
      "name": "nis",
      "description": {
        "content": "NIS is a supported external authorization provider. NIS can be used for authorizing user access to files and directories via NFS. NIS netgroups can be used to specify NFS hosts in view policies when controlling access permissions per NFS hosts. Up to one NIS configuration is supported. Limitations apply to the combinations of external providers and protocol enablement.",
        "type": "text/plain"
      },
