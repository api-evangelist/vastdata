{
  "opencollection": "1.0.0",
  "info": {
    "name": "VAST API Swagger Schema activedirectory dtrays API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ApiToken",
      "value": "{{ApiToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "dtrays",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List DTrays",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/dtrays/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Display specified page of results"
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "Filter list by DTray state"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter list by DTray name"
              },
              {
                "name": "enabled",
                "value": "",
                "type": "query",
                "description": "Filter by enabled state"
              }
            ]
          },
          "docs": "This endpoint lists the all DTrays."
        },
        {
          "info": {
            "name": "Return Details of a DTray",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/dtrays/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "DTray ID"
              }
            ]
          },
          "docs": "This endpoint returns details of a DTray."
        },
        {
          "info": {
            "name": "Activate/Deactivate DTray",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/dtrays/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "DTray ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint activates, deactivates a DTray."
        },
        {
          "info": {
            "name": "Control DTray (DNode) LEDs",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/dtrays/:id/control_led/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "DTray ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint controls the DTray (DNode) LEDs"
        },
        {
          "info": {
            "name": "Rename Dtray",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/dtrays/:id/rename/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Dtray ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint renames a Dtray."
        }
      ]
    }
  ],
  "bundled": true
}