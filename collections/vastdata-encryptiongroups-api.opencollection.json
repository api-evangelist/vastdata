{
  "opencollection": "1.0.0",
  "info": {
    "name": "VAST API Swagger Schema activedirectory encryptiongroups API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ApiToken",
      "value": "{{ApiToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "encryptiongroups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Encryption Groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/encryptiongroups/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "This endpoint lists encryption groups."
        },
        {
          "info": {
            "name": "Deactivate encryption group.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/encryptiongroups/:id/deactivate_encryption_group/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This endpoint deactivates an encryption group. Deactivated keys are revoked and destroyed. They cannot be reinstated. The encrypted data becomes inaccessible forever."
        },
        {
          "info": {
            "name": "Reinstate Encryption Group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/encryptiongroups/:id/reinstate_encryption_group/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This endpoint reinstates an encryption group key."
        },
        {
          "info": {
            "name": "Revoke Encryption Group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/encryptiongroups/:id/revoke_encryption_group/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This endpoint revokes an encryption group key."
        },
        {
          "info": {
            "name": "Rotate Encryption Group Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/encryptiongroups/:id/rotate_encryption_group_key/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This endpoint rotates an encryption group key."
        }
      ]
    }
  ],
  "bundled": true
}