{
  "opencollection": "1.0.0",
  "info": {
    "name": "VAST API Swagger Schema activedirectory envs API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ApiToken",
      "value": "{{ApiToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "envs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Envs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/envs/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "This endpoint lists envs."
        },
        {
          "info": {
            "name": "Return Details of an Env",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/envs/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This endpoint lists details of an env."
        }
      ]
    }
  ],
  "bundled": true
}