                "description": "apple sid"
              },
              {
                "name": "tenant_id",
                "value": "",
                "type": "query",
                "description": "Filter by tenant. Specify tenant ID."
              },
              {
                "name": "tenant_name__icontains",
                "value": "",
                "type": "query",
                "description": "Tenant name to filter by"
              },
              {
                "name": "serves_tenant",
                "value": "",
                "type": "query",
                "description": "Filter by served tenants. Accepts tenant ID or \"all\" for all served tenants."
              }
            ]
          },
          "docs": "This endpoint lists view policies. By default, all view policies are returned. The list can be filtered using optional parameters. A view policy is a reusable set of configurations that apply to views. Every view has a view policy. A view policy may be used by multiple views."
