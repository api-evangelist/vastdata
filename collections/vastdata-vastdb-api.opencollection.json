{
  "opencollection": "1.0.0",
  "info": {
    "name": "VAST API Swagger Schema activedirectory vastdb API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ApiToken",
      "value": "{{ApiToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "vastdb",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of DB access VIPs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/vastdb/vips/",
            "params": [
              {
                "name": "tenant_id",
                "value": "",
                "type": "query",
                "description": "Filter by tenant. Specify tenant ID."
              }
            ]
          },
          "docs": "This endpoint gets a list of DB access VIPs"
        }
      ]
    }
  ],
  "bundled": true
}