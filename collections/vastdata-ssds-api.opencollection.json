{
  "opencollection": "1.0.0",
  "info": {
    "name": "VAST API Swagger Schema activedirectory ssds API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ApiToken",
      "value": "{{ApiToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "ssds",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List SSDs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/ssds/",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "Filter by SSD state"
              },
              {
                "name": "sn",
                "value": "",
                "type": "query",
                "description": "Filter by SSD serial number"
              },
              {
                "name": "model",
                "value": "",
                "type": "query",
                "description": "Filter by SSD model"
              },
              {
                "name": "dbox__name",
                "value": "",
                "type": "query",
                "description": "Filter by parent DBox name"
              },
              {
                "name": "dbox__id",
                "value": "",
                "type": "query",
                "description": "Filter by parent DBox ID"
              },
              {
                "name": "fw_version",
                "value": "",
                "type": "query",
                "description": "Filter by SSD firmware version"
              }
            ]
          },
          "docs": "This endpoint lists SSDs."
        },
        {
          "info": {
            "name": "Return Details of an SSD",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/ssds/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This endpoint returns information about an SSD."
        },
        {
          "info": {
            "name": "Activate/Deactivate an SSD",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/ssds/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "SSD ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint activates or deactivates an SSD."
        },
        {
          "info": {
            "name": "Turn SSD identification LED on and off",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/ssds/:id/control_led/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "SSD ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint controls the ON/OFF state of the specified SSD's identification LED."
        },
        {
          "info": {
            "name": "Format SSD",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/ssds/:id/format/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "SSD ID"
              }
            ]
          },
          "docs": "This endpoint formats an SSD."
        }
      ]
    }
  ],
  "bundled": true
}