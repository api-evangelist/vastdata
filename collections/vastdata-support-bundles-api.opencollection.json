{
  "opencollection": "1.0.0",
  "info": {
    "name": "VAST API Swagger Schema activedirectory Support Bundles API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ApiToken",
      "value": "{{ApiToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Support Bundles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List queued supportbundles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/supportbundlesqueue/"
          },
          "docs": "This endpoint lists queued supportbundles"
        },
        {
          "info": {
            "name": "Move Support Bundle to a new position in a queue",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/supportbundlesqueue/:id/move",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Support Bundle ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint moves a supportbundle to a new position in a queue."
        }
      ]
    }
  ],
  "bundled": true
}