{
  "opencollection": "1.0.0",
  "info": {
    "name": "VAST API Swagger Schema activedirectory login API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ApiToken",
      "value": "{{ApiToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "login",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Log In",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/login/"
          },
          "docs": "This endpoint logs into VMS."
        }
      ]
    }
  ],
  "bundled": true
}