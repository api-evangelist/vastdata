{
  "opencollection": "1.0.0",
  "info": {
    "name": "VAST API Swagger Schema activedirectory filesystem API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ApiToken",
      "value": "{{ApiToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "filesystem",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Clone path",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/filesystem/clone/"
          },
          "docs": "This endpoint clones provided source_path to dest_path."
        }
      ]
    }
  ],
  "bundled": true
}