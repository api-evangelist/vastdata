  "item": [
    {
      "id": "58e37dfe-1982-4c0a-875f-d7711a2deceb",
      "name": "userquotas",
      "description": {
        "content": "A userquota object defines a user or group quota. A user or group quota limits the capacity and number of files or directories that a specified user or group can own within a directory. A userquota object doesn't specify any directory. A userquota object is effective when specified in a quota object.",
        "type": "text/plain"
      },
