  "item": [
    {
      "id": "66db3caa-e2ef-416e-84ad-3f4bd29958d5",
      "name": "protectionpolicies",
      "description": {
        "content": "A protection policy is a reusable configuration that defines a schedule for taking snapshots and optionally replicating them to a specified async  replication peer or S3 replication peer. It defines how long to retain local snapshots. If the purpose of a protection policy is remote backup to either S3 or an async replication peer without local snapshot retention, then this is achieved by defining no retention for local snapshots. Once defined, a protection policy can be specified in the configuration of a protected path.",
        "type": "text/plain"
      },
