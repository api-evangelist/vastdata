    {
      "id": "a0f9dffb-763a-4b64-89f1-ac760534528b",
      "name": "snapshots",
      "description": {
        "content": "A snapshot is an image of the data existing at a point in time under a specific Element Store path. Snapshots can be created on a one off basis or scheduled using a protected path. Scheduled snapshots can be retained locally, and/or backed up either to an S3 replication peer or to a replication peer.",
        "type": "text/plain"
      },
