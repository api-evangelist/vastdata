{
  "opencollection": "1.0.0",
  "info": {
    "name": "VAST API Swagger Schema activedirectory modules API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ApiToken",
      "value": "{{ApiToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "modules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Modules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/modules/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "This endpoint lists modules."
        },
        {
          "info": {
            "name": "Return Details of a Module.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/modules/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Module ID"
              }
            ]
          },
          "docs": "This endpoint returns details of a module."
        }
      ]
    }
  ],
  "bundled": true
}