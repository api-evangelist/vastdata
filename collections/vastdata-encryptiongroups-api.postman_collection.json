  "item": [
    {
      "id": "b58ddcf5-20ee-4f4c-9992-4fb3b59bf9fa",
      "name": "encryptiongroups",
      "description": {
        "content": "When data encryption is enabled on a VAST cluster with keys managed by an external key manager, each tenant must belong to an encryption group. Multiple tenants can belong to the same encryption group. It is also possible when creating a new path to encrypt the path with its own dedicated encryption group. This endpoint enables retrieval of encryption groups and their identifiers (CRN).",
        "type": "text/plain"
      },
