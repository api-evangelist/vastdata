{
  "opencollection": "1.0.0",
  "info": {
    "name": "VAST API Swagger Schema activedirectory vtasks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ApiToken",
      "value": "{{ApiToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "vtasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List vtasks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/vtasks/",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Task name"
              },
              {
                "name": "start_time__gte",
                "value": "",
                "type": "query"
              },
              {
                "name": "end_time__lte",
                "value": "",
                "type": "query"
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "Task state"
              }
            ]
          },
          "docs": "Get the list of async tasks."
        },
        {
          "info": {
            "name": "Return Task Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/vtasks/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This endpoint returns details of a vtask."
        },
        {
          "info": {
            "name": "Modify Vtask",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/vtasks/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Vtask ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint partially modifies a vtask."
        },
        {
          "info": {
            "name": "Retry/Rerun VTask",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/vtasks/:id/retry/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "VTask ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint reruns a vtask."
        }
      ]
    }
  ],
  "bundled": true
}